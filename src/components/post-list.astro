---
import {
  defaultLanguage,
  getCollection,
  useLocale,
  languages,
  type Language,
} from "@/i18n";
import { constants } from "@/constants";
import { formatDate } from "@/utils/format-date";

import Seo from "@/components/seo.astro";
import Search from "@/components/icons/search.svg";
import Calendar from "@/components/icons/calendar.svg";
import Clock from "@/components/icons/clock.svg";

const { lang = defaultLanguage } = Astro.props;
const t = useLocale(lang);

const posts = (await getCollection(lang)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const generateHref = (uri: string): string => {
  const isDefaultLanguage = lang === defaultLanguage;
  const prefix = isDefaultLanguage ? "" : lang;
  return `${prefix}/${uri}`;
};
---

<div id="search-bar">
  <input
    id="search-input"
    type="search"
    autocomplete="off"
    placeholder={t("search-posts")}
  />
  <Search />
</div>

<ul id="post-list">
  {
    posts.map((post) => (
      <li
        data-title={post.data.title.toLowerCase()}
        data-id={post.id.toLowerCase()}
      >
        <div class="post-header">
          <h2 class="post-title">
            <a class="underline-link" href={generateHref(post.id)}>
              {post.data.title}
            </a>
          </h2>

          <div class="post-dates">
            <span>
              <Calendar class="icon" />
              {formatDate(post.data.date, lang)}
            </span>
            <span>
              {post.data.updated && (
                <>
                  <span class="post-date-divider">&nbsp;· </span>
                  <Clock class="icon" />
                  {formatDate(post.data.updated, lang)}
                </>
              )}
            </span>
          </div>
        </div>

        <p>{post.data.description}</p>
      </li>
    ))
  }
</ul>

<script>
  const searchInput = document.getElementById("search-input");
  const listItems = document.querySelectorAll("#post-list li");

  searchInput?.addEventListener("input", (e) => {
    const query = e.target.value.toLowerCase().trim();
    listItems.forEach((item) => {
      const id = item.getAttribute("data-id");
      const title = item.getAttribute("data-title");
      if (title.includes(query) || id.includes(query)) {
        item.style.display = "";
      } else {
        item.style.display = "none";
      }
    });
  });
</script>

<style>
  h2,
  p {
    margin: 0;
  }

  #search-bar {
    position: relative;
    width: min(100dvw, 50ch);
    margin-inline: auto;
    padding-inline: 1rem;
  }

  #search-bar input {
    width: 100%;
    font-size: 1rem;
    padding-left: 2.75rem;
  }

  #search-bar svg {
    width: 2rem;
    aspect-ratio: 1 / 1;

    position: absolute;
    top: 50%;
    left: 1.5rem;
    transform: translateY(-50%);
    z-index: 1;
    color: var(--color-text);
    opacity: 0.5;
  }

  #search-bar:has(input:focus) svg {
    opacity: 1;
  }

  #post-list {
    list-style-type: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: min(100vw, 120ch);
    padding: 0 1rem;
    margin-inline: auto;
    gap: 0.875rem;
  }

  #post-list li {
    background: var(--color-bg-weak);
    border-radius: var(--round-base);
    border: 2px var(--border) solid;
    padding: 1rem;
    width: 100%;
  }

  .post-header {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    margin-bottom: 0.875rem;
    flex-wrap: wrap;
  }

  .post-dates {
    display: flex;
    align-items: center;
    opacity: 75%;
    font-size: 0.9rem;
    gap: 0.3125rem;
  }

  .post-dates span {
    display: flex;
    align-items: center;
    gap: 0.3125rem;
  }

  .icon {
    width: 1rem;
    height: 1rem;
  }

  @media only screen and (max-width: 560px) {
    .post-title {
      text-align: left;
      justify-content: start;
    }

    .post-dates {
      flex-direction: column;
      align-items: start;
    }

    .post-date-divider {
      display: none !important;
    }
  }
</style>
