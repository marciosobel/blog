---
import Calendar from "@/components/icons/calendar.svg";
import Clock from "@/components/icons/clock.svg";
import Search from "@/components/icons/search.svg";
import {
  defaultLanguage,
  getCollection,
  type Language,
  localizePath,
  useLocale,
} from "@/i18n";
import { formatDate } from "@/utils/format-date";

const { lang = defaultLanguage } = Astro.params as { lang?: Language };
const t = useLocale(lang);

const posts = await getCollection(lang);
---

<div id="search-bar">
  <input
    id="search-input"
    type="search"
    autocomplete="off"
    name="search-posts"
    placeholder={t("search-posts-placeholder")}
    aria-label={t("search-posts-label")}
  />
  <Search aria-hidden="true" />
</div>

<ul id="post-list" class="flex-center">
  {
    posts.map((post) => (
      <li
        data-search={`${post.data.title} ${post.data.description}`.toLowerCase()}
      >
        <div class="post-header">
          <h2 class="post-title">
            <a class="underline-link" href={localizePath(post.id, lang)}>
              {post.data.title}
            </a>
          </h2>

          <div class="post-dates">
            <span>
              <Calendar class="icon" />
              {formatDate(post.data.date, lang)}
            </span>
            <span>
              {post.data.updated && (
                <>
                  <span class="post-date-divider">&nbsp;· </span>
                  <Clock class="icon" />
                  {formatDate(post.data.updated, lang)}
                </>
              )}
            </span>
          </div>
        </div>

        <p>{post.data.description}</p>
      </li>
    ))
  }
</ul>

<script>
  const searchInput = document.getElementById("search-input") as HTMLInputElement | null;
  const listItems = document.querySelectorAll<HTMLElement>("#post-list li");

  const filter = () => {
    const query = searchInput?.value.toLowerCase().trim() ?? "";
    for (const item of listItems) {
      item.hidden = !item.dataset.search?.includes(query);
    }
  };

  searchInput?.addEventListener("input", filter);
  // The browser may restore the input's value on back/forward navigation.
  filter();
</script>

<style>
  h2,
  p {
    margin: 0;
  }

  #search-bar {
    position: relative;
    width: min(100dvw, 50ch);
    margin-inline: auto;
    padding-inline: 1rem;
  }

  #search-bar input {
    width: 100%;
    font-size: 1rem;
    padding-left: 2.75rem;
  }

  #search-bar svg {
    width: 2rem;
    aspect-ratio: 1 / 1;

    position: absolute;
    top: 50%;
    left: 1.5rem;
    transform: translateY(-50%);
    z-index: 1;
    color: var(--color-text);
    opacity: 0.5;
  }

  #search-bar:has(input:focus) svg {
    opacity: 1;
  }

  #post-list {
    list-style-type: none;
    flex-direction: column;
    width: min(100vw, 120ch);
    padding: 0 1rem;
    margin-inline: auto;
    gap: 0.875rem;
  }

  #post-list li {
    background: var(--color-bg-weak);
    border-radius: var(--round-base);
    border: 2px var(--border) solid;
    padding: 1rem;
    width: 100%;
  }

  .post-header {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    margin-bottom: 0.875rem;
    flex-wrap: wrap;
  }

  .post-dates {
    display: flex;
    align-items: center;
    opacity: 75%;
    font-size: 0.9rem;
    gap: 0.3125rem;
  }

  .post-dates span {
    display: flex;
    align-items: center;
    gap: 0.3125rem;
  }

  .icon {
    width: 1rem;
    height: 1rem;
  }

  @media only screen and (max-width: 560px) {
    .post-title {
      text-align: left;
      justify-content: start;
    }

    .post-dates {
      flex-direction: column;
      align-items: start;
    }

    .post-date-divider {
      display: none !important;
    }
  }
</style>
