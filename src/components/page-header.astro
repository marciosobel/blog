---
import LocaleSwitcher from "@/components/locale-switcher.astro";
import ThemeSwitcher from "@/components/theme-switcher.astro";
---

<header>
  <h1>Márcio Sobel - Blog</h1>
  <div class="header-buttons flex-center">
    <LocaleSwitcher />
    <ThemeSwitcher />
  </div>
</header>

<style>
  * {
    margin: 0;
  }

  header {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 0.625rem;
    align-items: center;
    margin-inline: 1.5rem;
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  h1 {
    grid-column-start: 2;
    text-align: center;
  }

  .header-buttons {
    justify-self: end;
    gap: 0.875rem;

    width: fit-content;
    height: fit-content;
  }

  @media only screen and (max-width: 560px) {
    header {
      grid-template-rows: auto auto;
      grid-template-columns: 1fr;
    }

    h1 {
      grid-column-start: 1;
      grid-row-start: 2;
    }

    .header-buttons {
      grid-row-start: 1;
      margin-inline: auto;
      width: 100%;
      justify-content: space-between;
    }
  }
</style>
