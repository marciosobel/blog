---
import type { MarkdownHeading } from "astro";
import { defaultLanguage, type Language, useLocale } from "@/i18n";

interface Props {
  headings: MarkdownHeading[];
}

const { lang = defaultLanguage } = Astro.params as { lang?: Language };
const t = useLocale(lang);

// Same shape as Nuxt Content's default TOC: h2 entries with their h3 children.
type Topic = MarkdownHeading & { children: MarkdownHeading[] };
const topics: Topic[] = [];
for (const heading of Astro.props.headings) {
  if (heading.depth === 2) {
    topics.push({ ...heading, children: [] });
  } else if (heading.depth === 3) {
    topics.at(-1)?.children.push(heading);
  }
}
---

{
  topics.length > 0 && (
    <aside class="post-index">
      <nav aria-label={t("post-index")}>
        <span class="topic-indicator" aria-hidden="true" hidden />
        <ul>
          {topics.map((topic) => (
            <li>
              <a href={`#${topic.slug}`} data-topic-id={topic.slug}>
                {topic.text}
              </a>
              {topic.children.length > 0 && (
                <ul>
                  {topic.children.map((child) => (
                    <li>
                      <a href={`#${child.slug}`} data-topic-id={child.slug}>
                        {child.text}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
      </nav>
    </aside>
  )
}

<script>
  const nav = document.querySelector<HTMLElement>(".post-index nav");

  if (nav) {
    const indicator = nav.querySelector<HTMLElement>(".topic-indicator")!;
    const links = [...nav.querySelectorAll<HTMLAnchorElement>("[data-topic-id]")];
    const headings = links
      .map((link) => document.getElementById(link.dataset.topicId!))
      .filter((heading): heading is HTMLElement => heading !== null);

    const setActive = (id: string) => {
      let activeLink: HTMLAnchorElement | undefined;
      for (const link of links) {
        const isActive = link.dataset.topicId === id;
        if (isActive) {
          link.setAttribute("aria-current", "location");
          activeLink = link;
        } else {
          link.removeAttribute("aria-current");
        }
      }

      if (!activeLink) return;
      const navBounds = nav.getBoundingClientRect();
      const linkBounds = activeLink.getBoundingClientRect();
      indicator.style.height = `${linkBounds.height}px`;
      indicator.style.transform = `translateY(${linkBounds.top - navBounds.top}px)`;
      indicator.hidden = false;
    };

    const updateActiveHeading = () => {
      const firstHeading = headings[0];
      if (!firstHeading) return;

      const readingLine = Math.min(window.innerHeight * 0.25, 160);
      let current = firstHeading;
      for (const heading of headings) {
        if (heading.getBoundingClientRect().top > readingLine) break;
        current = heading;
      }

      const pageBottom = window.scrollY + window.innerHeight;
      if (pageBottom >= document.documentElement.scrollHeight - 2) {
        current = headings.at(-1)!;
      }

      setActive(current.id);
    };

    let animationFrame: number | undefined;
    const scheduleUpdate = () => {
      if (animationFrame !== undefined) return;
      animationFrame = requestAnimationFrame(() => {
        animationFrame = undefined;
        updateActiveHeading();
      });
    };

    const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");

    for (const link of links) {
      link.addEventListener("click", (event) => {
        if (
          event.button !== 0 ||
          event.ctrlKey ||
          event.metaKey ||
          event.shiftKey ||
          event.altKey
        ) {
          return;
        }

        const heading = document.getElementById(link.dataset.topicId!);
        if (!heading) return;
        event.preventDefault();

        history.pushState(null, "", `#${heading.id}`);

        const temporaryTabIndex = !heading.hasAttribute("tabindex");
        if (temporaryTabIndex) {
          heading.tabIndex = -1;
          heading.addEventListener(
            "blur",
            () => heading.removeAttribute("tabindex"),
            { once: true },
          );
        }

        heading.focus({ preventScroll: true });
        heading.scrollIntoView({
          behavior: reducedMotion.matches ? "auto" : "smooth",
          block: "start",
        });
      });
    }

    updateActiveHeading();
    addEventListener("scroll", scheduleUpdate, { passive: true });
    addEventListener("resize", scheduleUpdate, { passive: true });
  }
</script>

<style>
  .post-index {
    position: sticky;
    top: 1.5rem;
    align-self: start;
    width: min(16rem, calc(100% - 2rem));
    max-height: calc(100dvh - 3rem);
    margin-left: 2rem;
    /* Nunito's glyphs are taller than this line-height, so the last line
       would otherwise overflow by ~1px and show a needless scrollbar. */
    padding-bottom: 0.25rem;
    overflow-y: auto;
    font-size: 0.9rem;
    line-height: 1.3;
  }

  nav {
    position: relative;
  }

  .topic-indicator {
    position: absolute;
    top: 0;
    left: 0;
    width: 2px;
    background: var(--color-accent1);
    border-radius: var(--round-base);
    transition:
      transform 180ms ease,
      height 180ms ease;
  }

  ul {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 0;
    padding: 0 0 0 0.75rem;
    list-style: none;
  }

  ul ul {
    gap: 0.35rem;
    margin-top: 0.35rem;
    padding-left: 1rem;
  }

  a {
    display: block;
    color: var(--color-text);
    opacity: 0.65;
    transition: opacity 125ms ease;
  }

  a:hover,
  a:focus-visible,
  a[aria-current="location"] {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .topic-indicator {
      transition: none;
    }
  }
</style>
