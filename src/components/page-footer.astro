---
import Earth from "@/components/icons/earth.svg";
import Github from "@/components/icons/github.svg";
import { defaultLanguage, type Language, useLocale } from "@/i18n";

const { lang = defaultLanguage } = Astro.params as { lang?: Language };
const t = useLocale(lang);
---

<footer class="flex-center">
  <a href="https://marciosobel.dev" aria-label={t("main-website")}>
    <Earth class="icon" aria-hidden="true" />
  </a>

  <a href="https://github.com/marciosobel" aria-label={t("github-label")}>
    <Github class="icon" aria-hidden="true" />
  </a>
</footer>

<style>
  footer {
    gap: 0.875rem;
    padding-block: 0.875rem;
  }

  a {
    display: flex;
    aspect-ratio: 1 / 1;
    padding: 0.5rem;
    border-radius: var(--round-base);
    transition: background 150ms ease;
  }

  a:hover {
    background: var(--color-bg-weak);
  }

  .icon {
    width: 1.25rem;
    height: 1.25rem;
  }
</style>
