---
import Moon from "@/components/icons/moon.svg";
import Sun from "@/components/icons/sun.svg";
import { defaultLanguage, type Language, useLocale } from "@/i18n";

const { lang = defaultLanguage } = Astro.params as { lang?: Language };
const t = useLocale(lang);
---

<button class="theme-toggler" aria-label={t("change-theme")}>
  <Sun class="sun" aria-hidden="true" />
  <Moon class="moon" aria-hidden="true" />
</button>

<style>
  .theme-toggler {
    aspect-ratio: 1 / 1;
    cursor: pointer;
    padding: 0;
    border-radius: 100%;
    background: transparent;
    transition:
      opacity 125ms ease,
      transform 125ms ease;
  }

  .theme-toggler:hover {
    transform: scale(1.1);
  }

  .theme-toggler:active {
    transform: scale(1.05);
  }

  .theme-toggler > :global(svg) {
    width: 2rem;
    height: 2rem;
    color: var(--color-text);
  }

  /* Matches the Nuxt version: the sun shows in dark mode, the moon in light mode. */
  .sun {
    display: none;
  }

  :global(.dark) .sun {
    display: block;
  }

  :global(.dark) .moon {
    display: none;
  }
</style>

<script>
  // The initial theme is applied by an inline script in <head> (see seo.astro).
  for (const button of document.querySelectorAll(".theme-toggler")) {
    button.addEventListener("click", () => {
      const isDark = document.documentElement.classList.toggle("dark");
      localStorage.setItem("theme", isDark ? "dark" : "light");
    });
  }
</script>
