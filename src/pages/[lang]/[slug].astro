---
import Post from "@/components/post.astro";
import { defaultLanguage, getCollection, type Language, languages } from "@/i18n";
import Base from "@/layouts/base.astro";

// The default language lives at the root, without a prefix.
export async function getStaticPaths() {
  const nonDefault = languages.filter((lang) => lang !== defaultLanguage);
  const paths = await Promise.all(
    nonDefault.map(async (lang) =>
      (await getCollection(lang)).map((post) => ({
        params: { lang, slug: post.id },
        props: { post },
      })),
    ),
  );
  return paths.flat();
}

const { lang } = Astro.params as { lang: Language };
const { post } = Astro.props;
---

<Base lang={lang} post={post}>
  <Post post={post} />
</Base>
